# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure OpenAI Embeddings Model Deployment Name
# You need to deploy text-embedding-ada-002 or text-embedding-3-small in your Azure OpenAI resource
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Cache settings
CACHE_DIR=.code_index_cache
CACHE_ENABLED=true

# Indexing settings
MAX_FILE_SIZE_MB=5
IGNORE_PATTERNS=node_modules,__pycache__,.git,.venv,venv,dist,build

# Supported file extensions
SUPPORTED_EXTENSIONS=.py,.js,.ts,.go,.rs,.java,.cpp,.c,.cs,.rb,.php,.swift,.kt,.scala
